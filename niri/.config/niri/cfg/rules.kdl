// This is where you can add your window rules.
// Many examples can be found in the system config file referenced in `niri/config.kdl`

// ────────────── Window Rules ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

window-rule {
    match app-id="niri-cheatsheet"

    open-floating true
    default-column-width { proportion 0.65; }
    default-window-height { proportion 0.8; }
}

window-rule {
    match app-id="steam"
    open-maximized true
    open-on-workspace "3"
}

window-rule {
    match app-id="com.github.hluk.copyq"

    open-floating true
    default-column-width { proportion 0.3; }
    default-window-height { proportion 0.6; }
}


window-rule {
    match app-id="org.keepassxc.KeePassXC"
    open-fullscreen false
    open-maximized false
}

window-rule {
    match app-id="btop-floating"

    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.7; }
}

window-rule {
    // Open specified Steam games in fullscreen mode
    match app-id="steam_app_1874880" // Arma Reforger (Proton)
    match title="Arma Reforger"

    // To open ALL Steam Proton games in fullscreen, uncomment the line below:
    // match app-id=r#"steam_app_\d+"#

    open-fullscreen true
}

window-rule {
  match app-id="factorio"
  open-fullscreen true
}
