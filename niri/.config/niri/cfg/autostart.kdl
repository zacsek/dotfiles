// This is where you can put custom auto-start commands, for example:
// spawn-sh-at-startup "notify-send 'System started!'"

// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

spawn-at-startup "steam" "-silent"
spawn-at-startup "maestral" "gui"
spawn-at-startup "copyq" "--start-server"
