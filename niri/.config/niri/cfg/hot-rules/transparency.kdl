// This is the system transparency defaults. Don't modify it or you'll break the update procedure.
include "~/.local/share/feathers-and-flame/config-ref/deployed/niri/cfg/transparency.kdl"

// If you want custom transparency rules, add them here at the end of this file.
// Feel free to look at the above file for examples on how that's done.
// You find information about a given window with `niri msg pick-window`.

// Custom transparency rules for Alacritty terminal
window-rule {
  match app-id="^Alacritty$"
  background-effect {
    blur true
  }
}

// Disable transparency for Neovim / Vim
window-rule {
  match app-id="^Alacritty$" title="(?i)n?vim"
  opacity 1.0
}

// Custom transparency rules for Ghostty terminal
window-rule {
  match app-id="com.mitchellh.ghostty"
  opacity 0.95
  background-effect {
    blur true
  }
}

// Disable transparency for Neovim / Vim in Ghostty
window-rule {
  match app-id="com.mitchellh.ghostty" title="(?i)n?vim"
  match app-id="com.mitchellh.ghostty" title="(?i)agy"
  match app-id="com.mitchellh.ghostty" title="(?i)github copilot"
  opacity 1.0
}

// Custom transparency and blur rules for Nautilus and Nemo (Files)
window-rule {
  match app-id="org.gnome.Nautilus"
  match app-id="nemo"
  opacity 0.93
  background-effect {
    blur true
  }
}

window-rule {
  match is-focused=false app-id="org.gnome.Nautilus"
  match is-focused=false app-id="nemo"
  opacity 0.85
}

// Disable transparency for Steam, Obsidian, Gimp, Discord, and browsers
window-rule {
  match app-id="steam"
  match app-id="obsidian"
  match app-id="gimp"
  match app-id="discord"
  match app-id=r#"(?i)chrome"#
  match app-id=r#"(?i)chromium"#
  match app-id=r#"(?i)browser"#
  match app-id=r#"(?i)firefox"#
  match app-id=r#"(?i)mullvad"#
  match app-id=r#"(?i)tor"#
  match app-id=r#"(?i)brave"#
  match app-id=r#"(?i)opera"#
  match app-id=r#"(?i)vivaldi"#

  opacity 1.0
}
