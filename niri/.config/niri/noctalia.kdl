layout {

    focus-ring {
        active-color   "#eeee5e"
        inactive-color "#2e2e0f"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#eeee5e"
        inactive-color "#2e2e0f"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#2e2e0f70"
    }

    tab-indicator {
        active-color   "#eeee5e"
        inactive-color "#969603"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#eeee5e80"
    }
}

recent-windows {
    highlight {
        active-color "#eeee5e"
        urgent-color "#fd4663"
    }
}
